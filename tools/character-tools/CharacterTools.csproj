<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <MeddleRoot Condition="'$(MeddleRoot)' == ''">../map-tools/Meddle/Meddle</MeddleRoot>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="$(MeddleRoot)/Meddle.Formats/Meddle.Formats.csproj" />
    <PackageReference Include="Lumina" Version="6.5.1" />
    <PackageReference Include="Lumina.Excel" Version="7.3.1" />
    <Compile Include="$(MeddleRoot)/Meddle.Utils/Export/Model.cs" Link="MeddleExport/Model.cs" />
    <Compile Include="$(MeddleRoot)/Meddle.Utils/Export/Mesh.cs" Link="MeddleExport/Mesh.cs" />
    <Compile Include="$(MeddleRoot)/Meddle.Utils/Export/Vertex.cs" Link="MeddleExport/Vertex.cs" />
    <Compile Include="$(MeddleRoot)/Meddle.Utils/Export/SubMesh.cs" Link="MeddleExport/SubMesh.cs" />
    <Compile Include="$(MeddleRoot)/Meddle.Utils/Export/ShapeMesh.cs" Link="MeddleExport/ShapeMesh.cs" />
    <Compile Include="$(MeddleRoot)/Meddle.Utils/Export/ModelShape.cs" Link="MeddleExport/ModelShape.cs" />
  </ItemGroup>
</Project>
